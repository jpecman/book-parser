# Copy to .env and fill in. Generate a key with: openssl rand -hex 32
QDRANT_API_KEY=

# Where the Python client connects. Defaults to http://localhost:6333.
# QDRANT_URL=

# Which embedding model to use: azure (default), fastembed (local) or ollama.
# EMBEDDING_PROVIDER=azure

# Maximum chunk length in characters. Defaults to 500.
# CHUNK_SIZE=500

# How many sentences a chunk repeats from the end of the previous one. Defaults to 1.
# CHUNK_OVERLAP=1

# Which lemmatizer turns Czech words into base forms: morphodita (default).
# LEMMATIZER=morphodita

# MorphoDiTa model file, e.g. czech-morfflex2.0-pdtc1.0-220710.tagger from
# "Czech MorfFlex 2.0 + PDT-C 1.0" on LINDAT (CC BY-NC-SA).
# MORPHODITA_TAGGER=~/models/czech-morfflex2.0-pdtc1.0-220710/czech-morfflex2.0-pdtc1.0-220710.tagger

# Azure OpenAI, used to embed text.
AZURE_OPENAI_ENDPOINT=https://<resource-name>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
OPENAI_API_VERSION=2024-10-21

# Ollama, used to embed text when EMBEDDING_PROVIDER=ollama.
# Where the Ollama server is. Defaults to http://localhost:11434.
# OLLAMA_URL=
# Name of a model pulled on that server, e.g. bge-m3.
# OLLAMA_EMBEDDING_MODEL=
